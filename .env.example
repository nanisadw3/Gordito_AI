# Spotify Credentials (para el DJ de Código)
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:9090
MI_SPOTIFY_WORKERS=

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Banxico SIE (mcp-banxico): https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=your_banxico_token_here

# INEGI (mcp-inegi). Indicadores: https://www.inegi.org.mx/app/desarrolladores/generatoken/Usuarios/token_Verify
INEGI_TOKEN=your_inegi_token_here
# DENUE (directorio de negocios, token distinto): https://www.inegi.org.mx/app/api/denue/tokenVerify/tokenverify.html
DENUE_TOKEN=your_denue_token_here
